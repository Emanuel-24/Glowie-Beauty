{
  "name": "glowe-beauty-backend",
  "version": "1.0.0",
  "description": "Backend API para Glowe Beauty",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "db:clean": "node src/clean-db.js",
    "check": "node --check src/server.js && node --check src/seed.js && node --check src/clean-db.js",
    "lint": "node --check src/server.js",
